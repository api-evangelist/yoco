{
  "opencollection": "1.0.0",
  "info": {
    "name": "Yoco Online Payments Checkout Webhooks API",
    "version": "2026-07-12"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://payments.yoco.com/api/webhooks",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists the webhook endpoints registered for your account."
        },
        {
          "info": {
            "name": "Register a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://payments.yoco.com/api/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Registers a webhook endpoint that Yoco will POST signed events to."
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://payments.yoco.com/api/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Removes a registered webhook endpoint."
        }
      ]
    }
  ],
  "bundled": true
}